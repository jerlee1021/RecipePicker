# Copy to .env and fill in from Neon (or Vercel > Storage > your database).

# Pooled connection (hostname contains "-pooler"). Used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Direct connection (no "-pooler"). Used by the Prisma CLI for migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"
